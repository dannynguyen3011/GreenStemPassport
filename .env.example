# ─── Supabase (PostgreSQL + Auth) ────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here    # Never expose to client!

# ─── PostgreSQL Direct Connection ─────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string
# Use "Transaction" pooler URL for serverless (Next.js API routes)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── ChromaDB (Vector Database for RAG) ──────────────────────────────────────
# Self-hosted on Railway or localhost for dev
# Railway: Deploy chromadb/chroma Docker image, copy the public URL
CHROMA_URL=http://localhost:8000

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin Access Control ─────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs with admin privileges
# Get user UUIDs from: Supabase → Authentication → Users
ADMIN_USER_IDS=uuid-1,uuid-2

# ─── Data Freshness ───────────────────────────────────────────────────────────
# Last date the RAG corpus was re-ingested (displayed in chatbot disclaimer)
RAG_DATA_FRESHNESS_DATE=2026-04-01

# ─── Resend (Email — TrustFactor Tier 2 teacher verification) ─────────────────
# Get from: https://resend.com → API Keys
# Optional for MVP (Tier 2 uses admin manual review fallback)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@greenstemcompass.vn
